<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur5_robotiq_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, controllers and Gazebo worlds of the UR5 + Robotiq 2F-85 simulation.</description>
  <maintainer email="mates21@ku.edu.tr">mates</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>gripper_controllers</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ur5_robotiq_description</exec_depend>
  <exec_depend>ur5_robotiq_moveit_config</exec_depend>
  <exec_depend>ur_controllers</exec_depend>
  <exec_depend>ur_simulation_gz</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
